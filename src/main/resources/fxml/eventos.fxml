<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.soprasteria.sportapp.admin.controller.EventosController"
      stylesheets="@/styles/style.css"
      style="-fx-background-color: #F8FAFC;"
      prefWidth="1100" prefHeight="700">

    <!-- MENÚ LATERAL -->
    <VBox spacing="0" style="-fx-background-color: #1E293B;" prefWidth="250">
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #0F172A; -fx-border-color: #334155; -fx-border-width: 0 1 1 0;">
            <Label text="SportApp Admin" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
            <Label fx:id="nombreAdminLabel" text="Admin" style="-fx-text-fill: #94A3B8; -fx-font-size: 12;"/>
        </VBox>
        <Button text="📊 Dashboard"          onAction="#navToDashboard"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="👥 Usuarios"           onAction="#navToUsuarios"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="⚽ Eventos"
                style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="⭐ Eventos Especiales" onAction="#navToEventosEspeciales"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="💬 Soporte"            onAction="#navToSoporte"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="📈 Estadísticas"       onAction="#navToEstadisticas"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <VBox VBox.vgrow="ALWAYS"/>
        <Button text="🚪 Cerrar sesión" onAction="#handleCerrarSesion"
                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
    </VBox>

    <!-- CONTENIDO PRINCIPAL -->
    <VBox fx:id="contenedorPrincipal" spacing="20" style="-fx-padding: 30;" HBox.hgrow="ALWAYS">

        <HBox spacing="15" style="-fx-alignment: CENTER_LEFT;">
            <Label text="⚽ Gestión de Eventos"
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
            <Label fx:id="contadorLabel" text=""
                   style="-fx-text-fill: #64748B; -fx-font-size: 14; -fx-padding: 4 10; -fx-background-color: #DBEAFE; -fx-background-radius: 12;"/>
        </HBox>

        <!-- Filtros -->
        <HBox spacing="10" style="-fx-alignment: CENTER_LEFT;">
            <TextField fx:id="buscadorField" promptText="🔍  Buscar por título o deporte..." prefWidth="300"
                       style="-fx-padding: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13;"/>
            <ComboBox fx:id="filtroDeporte" promptText="Todos los deportes" prefWidth="180"
                      style="-fx-font-size: 13;"/>
            <Button text="Buscar" onAction="#handleBuscar"
                    style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 13;"/>
            <Button text="Mostrar todos" onAction="#handleMostrarTodos"
                    style="-fx-background-color: transparent; -fx-text-fill: #2563EB; -fx-border-color: #2563EB; -fx-border-radius: 6; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-size: 13;"/>
        </HBox>

        <!-- Tabla -->
        <TableView fx:id="tablaEventos" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8;">
            <placeholder><Label text="No hay eventos"/></placeholder>
            <columns>
                <TableColumn fx:id="colTitulo"        text="Título"          prefWidth="220"/>
                <TableColumn fx:id="colDeporte"       text="Deporte"         prefWidth="100"/>
                <TableColumn fx:id="colFecha"         text="Fecha"           prefWidth="100"/>
                <TableColumn fx:id="colHora"          text="Hora"            prefWidth="70"/>
                <TableColumn fx:id="colCreador"       text="Creador"         prefWidth="130"/>
                <TableColumn fx:id="colParticipantes" text="Participantes"   prefWidth="140"/>
            </columns>
        </TableView>

        <!-- Botones -->
        <HBox spacing="10">
            <Button fx:id="btnEliminar" text="🗑️ Eliminar evento" onAction="#handleEliminar" disable="true"
                    style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 13;"/>
        </HBox>
    </VBox>
</HBox>
