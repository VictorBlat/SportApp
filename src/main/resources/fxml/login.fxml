<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Separator?>
<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.soprasteria.sportapp.admin.controller.LoginController"
           stylesheets="@../styles/style.css">

    <!-- Fondo gradient azul -->
    <VBox style="-fx-background-color: linear-gradient(to bottom, #2563EB, #1D4ED8);"
          alignment="CENTER">

        <!-- Card de login -->
        <VBox styleClass="login-card"
              spacing="20"
              prefWidth="350"
              style="-fx-background-color: white;
                     -fx-padding: 40;
                     -fx-border-radius: 10;
                     -fx-background-radius: 10;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

            <alignment>CENTER</alignment>

            <!-- Logo y título -->
            <VBox spacing="10" alignment="CENTER">
                <Label text="SportApp"
                       style="-fx-text-fill: #2563EB; -fx-font-size: 28; -fx-font-weight: bold;"/>
                <Label text="Panel de Administración"
                       style="-fx-text-fill: #64748B; -fx-font-size: 14;"/>
            </VBox>

            <!-- Separador -->
            <Separator style="-fx-padding: 10 0;"/>

            <!-- Email -->
            <VBox spacing="8">
                <Label text="Email"
                       style="-fx-text-fill: #1E293B; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <TextField fx:id="emailField"
                          promptText="admin@sportapp.com"
                          style="-fx-padding: 10;
                                 -fx-border-color: #E2E8F0;
                                 -fx-border-radius: 5;
                                 -fx-background-radius: 5;
                                 -fx-font-size: 12;"/>
            </VBox>

            <!-- Contraseña -->
            <VBox spacing="8">
                <Label text="Contraseña"
                       style="-fx-text-fill: #1E293B; -fx-font-size: 12; -fx-font-weight: bold;"/>
                <PasswordField fx:id="passwordField"
                              promptText="Contraseña"
                              style="-fx-padding: 10;
                                     -fx-border-color: #E2E8F0;
                                     -fx-border-radius: 5;
                                     -fx-background-radius: 5;
                                     -fx-font-size: 12;"/>
            </VBox>

            <!-- Botón acceder -->
            <Button fx:id="botonAcceder"
                   text="Acceder"
                   onAction="#handleLogin"
                   style="-fx-padding: 12;
                          -fx-background-color: #2563EB;
                          -fx-text-fill: white;
                          -fx-font-size: 14;
                          -fx-font-weight: bold;
                          -fx-border-radius: 5;
                          -fx-background-radius: 5;
                          -fx-cursor: hand;"
                   maxWidth="Infinity"/>

            <!-- Nota de seguridad -->
            <Label text="Las credenciales son proporcionadas por el administrador del sistema"
                   style="-fx-text-fill: #64748B; -fx-font-size: 10; -fx-wrap-text: true;"
                   wrapText="true"/>

        </VBox>

    </VBox>
</StackPane>