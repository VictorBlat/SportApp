<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.soprasteria.sportapp.admin.controller.SoporteController"
      stylesheets="@/styles/style.css"
      style="-fx-background-color: #F8FAFC;"
      prefWidth="1100" prefHeight="700">

    <!-- MENÚ LATERAL -->
    <VBox spacing="0" style="-fx-background-color: #1E293B;" prefWidth="250">
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #0F172A; -fx-border-color: #334155; -fx-border-width: 0 1 1 0;">
            <Label text="SportApp Admin" style="-fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold;"/>
            <Label fx:id="nombreAdminLabel" text="Admin" style="-fx-text-fill: #94A3B8; -fx-font-size: 12;"/>
        </VBox>
        <Button text="📊 Dashboard"          onAction="#navToDashboard"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="👥 Usuarios"           onAction="#navToUsuarios"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="⚽ Eventos"            onAction="#navToEventos"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="⭐ Eventos Especiales" onAction="#navToEventosEspeciales"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="💬 Soporte"
                style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <Button text="📈 Estadísticas"       onAction="#navToEstadisticas"
                style="-fx-background-color: #1E293B; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
        <VBox VBox.vgrow="ALWAYS"/>
        <Button text="🚪 Cerrar sesión" onAction="#handleCerrarSesion"
                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-padding: 15; -fx-alignment: CENTER_LEFT; -fx-font-size: 13; -fx-border-width: 0; -fx-cursor: hand;" maxWidth="Infinity"/>
    </VBox>

    <!-- CONTENIDO -->
    <VBox fx:id="contenedorPrincipal" spacing="20" style="-fx-padding: 30;" HBox.hgrow="ALWAYS">

        <!-- Cabecera -->
        <HBox spacing="15" style="-fx-alignment: CENTER_LEFT;">
            <Label text="💬 Solicitudes de Soporte"
                   style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
            <Label fx:id="pendientesLabel" text="0 pendientes"
                   style="-fx-text-fill: white; -fx-font-size: 13; -fx-padding: 4 10; -fx-background-color: #F97316; -fx-background-radius: 12;"/>
        </HBox>

        <!-- Filtro estado -->
        <HBox spacing="10" style="-fx-alignment: CENTER_LEFT;">
            <Label text="Filtrar por estado:" style="-fx-text-fill: #64748B; -fx-font-size: 13;"/>
            <ComboBox fx:id="filtroEstado" prefWidth="180" style="-fx-font-size: 13;"/>
            <Button text="Actualizar" onAction="#handleActualizar"
                    style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 13;"/>
        </HBox>

        <!-- Tabla + panel detalle -->
        <HBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- Tabla -->
            <TableView fx:id="tablaSolicitudes" HBox.hgrow="ALWAYS"
                       style="-fx-background-color: white; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8;">
                <placeholder><Label text="No hay solicitudes"/></placeholder>
                <columns>
                    <TableColumn fx:id="colUsuario" text="Usuario"  prefWidth="150"/>
                    <TableColumn fx:id="colAsunto"  text="Asunto"   prefWidth="200"/>
                    <TableColumn fx:id="colEstado"  text="Estado"   prefWidth="120"/>
                    <TableColumn fx:id="colFecha"   text="Fecha"    prefWidth="110"/>
                </columns>
            </TableView>

            <!-- Panel de detalle -->
            <VBox fx:id="panelDetalle" spacing="15"
                  style="-fx-background-color: white; -fx-padding: 20; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8;"
                  minWidth="280" maxWidth="280">

                <Label text="Detalle de la solicitud"
                       style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>

                <VBox spacing="4">
                    <Label text="Usuario" style="-fx-text-fill: #64748B; -fx-font-size: 11;"/>
                    <Label fx:id="detalleUsuario" text="-"
                           style="-fx-text-fill: #1E293B; -fx-font-size: 13; -fx-wrap-text: true;"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Asunto" style="-fx-text-fill: #64748B; -fx-font-size: 11;"/>
                    <Label fx:id="detalleAsunto" text="-"
                           style="-fx-text-fill: #1E293B; -fx-font-size: 13; -fx-wrap-text: true;"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Estado" style="-fx-text-fill: #64748B; -fx-font-size: 11;"/>
                    <Label fx:id="detalleEstado" text="-"
                           style="-fx-text-fill: #1E293B; -fx-font-size: 13;"/>
                </VBox>

                <VBox spacing="4">
                    <Label text="Fecha" style="-fx-text-fill: #64748B; -fx-font-size: 11;"/>
                    <Label fx:id="detalleFecha" text="-"
                           style="-fx-text-fill: #1E293B; -fx-font-size: 13;"/>
                </VBox>

                <VBox spacing="4" VBox.vgrow="ALWAYS">
                    <Label text="Descripción" style="-fx-text-fill: #64748B; -fx-font-size: 11;"/>
                    <TextArea fx:id="detalleDescripcion" editable="false" wrapText="true"
                              prefRowCount="5"
                              style="-fx-font-size: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-background-radius: 6;"/>
                </VBox>

                <Button fx:id="btnEnRevision" text="🔄 Marcar en revisión"
                        onAction="#handleMarcarEnRevision" disable="true" maxWidth="Infinity"
                        style="-fx-background-color: #F97316; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 12;"/>
                <Button fx:id="btnResuelto" text="✅ Marcar como resuelto"
                        onAction="#handleMarcarResuelto" disable="true" maxWidth="Infinity"
                        style="-fx-background-color: #22C55E; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-size: 12;"/>
            </VBox>
        </HBox>
    </VBox>
</HBox>
